{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "ubuntu_small",
    "color": {
      "1": "bright_black",
      "2": "white",
      "3": "white",
      "4": "bright_black",
      "5": "bright_black",
      "6": "bright_black"
    },
    "padding": {
      "top": 1,
      "left": 12,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "white",
      "title": "bright_white",
      "output": "white"
    }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os",       "key": "OS      ", "keyWidth": 10 },
    { "type": "kernel",   "key": "Kernel  ", "keyWidth": 10 },
    { "type": "shell",    "key": "Shell   ", "keyWidth": 10 },
    { "type": "terminal", "key": "Terminal", "keyWidth": 10 },
    "separator",
    { "type": "display", "key": "Display", "keyWidth": 10 },
    { "type": "cpu",    "key": "CPU    ", "keyWidth": 10 },
    { "type": "gpu",    "key": "GPU    ", "keyWidth": 10, "detectionMethod": "pci" },
    { "type": "memory", "key": "RAM    ", "keyWidth": 10 },
    "separator"
  ]
}
