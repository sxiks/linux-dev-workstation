#!/usr/bin/env bash
#
# ~/dotfiles/scripts/dotpush
#
# Interfaz segura para publicar cambios del repositorio de dotfiles en
# GitHub. Responsabilidad EXCLUSIVA: Git local -> GitHub, con revisión
# explícita en cada paso. NUNCA ejecuta export_apps.sh/import_apps.sh,
# NUNCA instala/desinstala software, NUNCA toca configuración del sistema
# fuera de Git/Stow.
#
# Flujo obligatorio, sin atajos:
#   status -> diff -> selección explícita -> git add <archivos> ->
#   diff --staged -> confirmación de commit -> commit ->
#   confirmación separada de push -> push
#
# Uso: ./dotpush   (sin argumentos)

set -euo pipefail

cd "$HOME/dotfiles"

# --- 0. Pre-flight: nunca operar sobre un merge/rebase a medias ---
if [[ -d .git/rebase-merge || -d .git/rebase-apply || -f .git/MERGE_HEAD ]]; then
    echo "ERROR: hay un merge o rebase en curso en este repositorio." >&2
    echo "Resuélvelo manualmente antes de usar dotpush. No se hizo ningún cambio." >&2
    exit 1
fi

# --- 1. Estado actual ---
echo "=== git status ==="
git status --short

if [[ -z "$(git status --porcelain)" ]]; then
    echo
    echo "Nada que publicar. El repositorio está limpio."
    exit 0
fi

echo
echo "=== git diff (cambios sin stagear) ==="
git diff

# --- Aviso de archivos ya staged antes de ejecutar dotpush ---
PRE_STAGED="$(git diff --cached --name-only)"
if [[ -n "$PRE_STAGED" ]]; then
    echo
    echo "AVISO: estos archivos ya estaban en staging ANTES de ejecutar dotpush:"
    echo "$PRE_STAGED"
    echo "Se incluirán en la lista de candidatos abajo como cualquier otro archivo."
fi

# --- 2. Selección explícita de archivos ---
mapfile -t CANDIDATES < <(git status --porcelain | sed -E 's/^...//')

echo
echo "=== Archivos disponibles ==="
for i in "${!CANDIDATES[@]}"; do
    printf "  [%d] %s\n" "$((i + 1))" "${CANDIDATES[$i]}"
done

echo
echo "Selecciona archivos a incluir:"
echo "  'todos'    -> todos los listados arriba"
echo "  '1 3 4'    -> números separados por espacio"
echo "  'cancelar' -> salir sin tocar nada"
read -rp "> " selection

SELECTED=()
case "$selection" in
    cancelar|"")
        echo "Cancelado. No se modificó el staging."
        exit 0
        ;;
    todos)
        SELECTED=("${CANDIDATES[@]}")
        ;;
    *)
        for n in $selection; do
            if ! [[ "$n" =~ ^[0-9]+$ ]]; then
                echo "ERROR: entrada inválida '$n'. Abortando sin tocar nada." >&2
                exit 1
            fi
            idx=$((n - 1))
            if (( idx >= 0 && idx < ${#CANDIDATES[@]} )); then
                SELECTED+=("${CANDIDATES[$idx]}")
            else
                echo "ERROR: índice fuera de rango '$n'. Abortando sin tocar nada." >&2
                exit 1
            fi
        done
        ;;
esac

if [[ ${#SELECTED[@]} -eq 0 ]]; then
    echo "Ningún archivo seleccionado. Cancelado."
    exit 0
fi

# --- 3. git add controlado (NUNCA 'git add .') ---
echo
echo "=== git add (solo los archivos seleccionados) ==="
git add -- "${SELECTED[@]}"

# --- 4. Mostrar exactamente lo que se va a commitear ---
echo
echo "=== git diff --staged ==="
git diff --staged

# --- 5. Confirmación de commit ---
echo
read -rp "¿Confirmar commit con estos cambios? [s/N]: " confirm_commit
if [[ ! "$confirm_commit" =~ ^[sS]$ ]]; then
    echo "Cancelado antes del commit. Revirtiendo staging de los archivos seleccionados..."
    git reset -- "${SELECTED[@]}"
    echo "Staging revertido. El contenido de los archivos no fue tocado."
    exit 0
fi

read -rp "Mensaje de commit: " msg
if [[ -z "$msg" ]]; then
    echo "ERROR: mensaje de commit vacío. Abortando sin commitear." >&2
    git reset -- "${SELECTED[@]}"
    echo "Staging revertido." >&2
    exit 1
fi

if ! git commit -m "$msg"; then
    echo "ERROR: git commit falló. El staging se mantiene tal cual para que puedas diagnosticar." >&2
    exit 1
fi

echo
echo "=== Commit creado ==="
git log -1 --stat

# --- 6. Confirmación SEPARADA de push ---
echo
read -rp "¿Confirmar push a origin/main? [s/N]: " confirm_push
if [[ ! "$confirm_push" =~ ^[sS]$ ]]; then
    echo
    echo "Push cancelado. El commit YA existe localmente (no se revierte automáticamente)."
    echo "Para subirlo más tarde:  git push origin main"
    echo "Para deshacerlo (si aún no lo compartiste):  git reset --soft HEAD~1"
    exit 0
fi

if ! git push origin main; then
    echo "ERROR: git push falló. El commit local se mantiene intacto." >&2
    echo "Revisa la salida anterior (posible rechazo remoto, conflicto, red, etc.)." >&2
    exit 1
fi

echo
echo "✓ dotpush completado: commit publicado en origin/main."
