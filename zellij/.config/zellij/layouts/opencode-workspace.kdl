layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
        children
    }

    tab name="system" {
        pane {
            command "btop"
        }
    }

    tab name="dev" {
        pane split_direction="vertical" {
            pane size="65%" {
                command "yazi"
                cwd "/home/sxiks/proyectos"
            }
            pane size="35%" {
                pane {
                    command "/home/sxiks/.config/zellij/git-panel.sh"
                }
                pane {
                    command "bash"
                    cwd "/home/sxiks/proyectos"
                }
            }
        }
    }

    tab name="agent-code" {
        pane split_direction="vertical" {
            pane size="40%" {
                command "yazi"
                cwd "/home/sxiks/proyectos"
            }
            pane size="60%" {
                command "opencode"
            }
        }
    }
}
