{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "ubuntu_small",
    "color": {
      "1": "38;5;244",
      "2": "38;5;250",
      "3": "38;5;244",
      "4": "38;5;250"
    },
    "padding": {
      "top": 1,
      "left": 3,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;5;244",
      "title": "white"
    }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os",       "key": "OS      ", "keyWidth": 10 },
    { "type": "kernel",   "key": "Kernel  ", "keyWidth": 10 },
    { "type": "uptime",   "key": "Uptime  ", "keyWidth": 10 },
    { "type": "packages", "key": "Pkgs    ", "keyWidth": 10 },
    { "type": "shell",    "key": "Shell   ", "keyWidth": 10 },
    { "type": "terminal", "key": "Terminal", "keyWidth": 10 },
    "separator",
    { "type": "cpu",    "key": "CPU    ", "keyWidth": 10 },
    { "type": "gpu",    "key": "GPU    ", "keyWidth": 10, "detectionMethod": "pci" },
    { "type": "memory", "key": "RAM    ", "keyWidth": 10 },
    { "type": "disk",   "key": "Disk   ", "keyWidth": 10, "folders": "/" },
    "separator"
  ]
}
